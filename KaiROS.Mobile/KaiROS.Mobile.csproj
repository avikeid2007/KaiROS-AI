<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-focused for LLM on mobile -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>KaiROS.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>KaiROS AI</ApplicationTitle>

		<!-- App Identifier -->
		<!-- App Identifier -->
		<ApplicationId>com.avnishkumar.kairosai</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android minimum API level -->
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		
		<!-- Allow duplicate native libs from LLamaSharp backends -->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0D0D1A" ForegroundScale="0.45" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0D0D1A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAUI -->
		<PackageReference Include="LLamaSharp.Backend.Cpu.Android" Version="0.30.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
				<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
		
		<!-- MVVM Toolkit -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.1.1" />
		
		<!-- LLamaSharp for local LLM inference -->
		<PackageReference Include="LLamaSharp" Version="0.30.0" />
		
		<!-- SQLite for chat history -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		
		<!-- Markdown Parsing -->
		<PackageReference Include="Markdig" Version="1.6.0" />
	</ItemGroup>

</Project>
