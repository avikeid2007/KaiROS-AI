<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-browserwasm;net9.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>KaiROS.AI.Uno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.KaiROS.AI.Uno</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>User</ApplicationPublisher>
    <!-- Package Description -->
    <Description>KaiROS.AI.Uno powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Lottie;
      Hosting;
      Toolkit;
      Logging;
      Mvvm;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>

    <!-- Common Language Settings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- Package Identity -->
    <PackageId>34488AvnishKumar.KaiROSAI</PackageId>

    <!-- Version and Assembly Info -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>KaiROS AI</Product>
    <Company>KaiROS</Company>
    <Copyright>Copyright © 2024 KaiROS</Copyright>

    <!-- Suppress duplicate native lib warning from multiple LLamaSharp backends -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>

    <!-- Define DESKTOP constant for desktop builds -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net9.0-desktop'">$(DefineConstants);DESKTOP</DefineConstants>
  </PropertyGroup>

  <!-- Cross-platform Package References -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="itext7" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <!-- Desktop-only Package References (LLamaSharp with native backends) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-desktop'">
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!-- Configuration file support -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
