<UserControl x:Class="KaiROS.AI.Uno.Views.ModelCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:KaiROS.AI.Uno.Converters"
             xmlns:vm="using:KaiROS.AI.Uno.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Margin="0,0,0,16"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12">
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="Model Catalog" />
                    <TextBlock Margin="0,4,0,0"
                               Opacity="0.7"
                               Text="Download and manage local LLM models" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="0,0,8,0"
                                  FontSize="14"
                                  Glyph="&#xE710;" />
                        <TextBlock Text="Add Custom Model" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <!-- Search -->
                <TextBox Width="200"
                         Margin="0,0,12,0"
                         PlaceholderText="Search models..."
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Organization Filter -->
                <ComboBox Width="120"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Organizations}"
                          SelectedItem="{Binding SelectedOrganization, Mode=TwoWay}" />

                <!-- Family Filter -->
                <ComboBox Width="120"
                          Margin="0,0,12,0"
                          ItemsSource="{Binding Families}"
                          SelectedItem="{Binding SelectedFamily, Mode=TwoWay}" />

                <!-- Recommended Toggle -->
                <ToggleButton Margin="0,0,12,0"
                              Content="Recommended Only"
                              IsChecked="{Binding ShowRecommendedOnly, Mode=TwoWay}" />

                <!-- Expand/Collapse -->
                <Button Margin="0,0,8,0"
                        Command="{Binding ExpandAllCommand}"
                        Content="Expand All" />
                <Button Command="{Binding CollapseAllCommand}"
                        Content="Collapse All" />
            </StackPanel>
        </Border>

        <!-- Model List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GroupedModels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Organization Group -->
                        <StackPanel Margin="0,0,0,16">
                            <!-- Group Header -->
                            <Border Padding="12,8"
                                    Background="{ThemeResource LayerFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding OrganizationName}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Opacity="0.6">
                                            <Run Text="{Binding ModelCount}" />
                                            <Run Text="models" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.6">
                                        <Run Text="{Binding DownloadedCount}" />
                                        <Run Text="downloaded" />
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Models in Group -->
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="16"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <!-- Model Name -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Model.DisplayName}" />
                                                        <Border Margin="8,0,0,0"
                                                                Padding="6,2"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding Model.IsRecommended, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="White"
                                                                       Text="Recommended" />
                                                        </Border>
                                                        <Border Margin="8,0,0,0"
                                                                Padding="6,2"
                                                                Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding Model.IsVisionModel, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="White"
                                                                       Text="Vision" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Description -->
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Text="{Binding Model.Description}"
                                                               TextWrapping="Wrap" />

                                                    <!-- Size & RAM -->
                                                    <StackPanel Margin="0,8,0,0"
                                                                Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon FontSize="11" Glyph="&#xE91B;" Opacity="0.6" />
                                                            <TextBlock Margin="4,0,0,0" FontSize="11" Opacity="0.6" Text="{Binding Model.SizeText}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
                                                            <FontIcon FontSize="11" Glyph="&#xE9F3;" Opacity="0.6" />
                                                            <TextBlock Margin="4,0,0,0" FontSize="11" Opacity="0.6">
                                                                <Run Text="{Binding Model.MinRam}" />
                                                                <Run Text="RAM" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Error Message -->
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource SystemErrorTextColor}"
                                                               Text="{Binding ErrorMessage}"
                                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <!-- Download Progress -->
                                                    <StackPanel Margin="0,0,8,0"
                                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                        <ProgressBar Width="100"
                                                                     Maximum="100"
                                                                     Value="{Binding DownloadProgress}" />
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="10"
                                                                   Text="{Binding DownloadProgress}" />
                                                    </StackPanel>

                                                    <!-- Download Button -->
                                                    <Button Margin="0,0,8,0"
                                                            Command="{Binding DownloadCommand}"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon Margin="0,0,6,0"
                                                                      FontSize="14"
                                                                      Glyph="&#xE896;" />
                                                            <TextBlock Text="Download" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Load Button -->
                                                    <Button Margin="0,0,8,0"
                                                            Command="{Binding SetActiveCommand}"
                                                            Style="{StaticResource DefaultButtonStyle}"
                                                            Visibility="{Binding ShowLoadButton, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon Margin="0,0,6,0"
                                                                      FontSize="14"
                                                                      Glyph="&#xE9F4;" />
                                                            <TextBlock Text="Load" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Active Badge -->
                                                    <Border Padding="8,4"
                                                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                            CornerRadius="4"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="Active" />
                                                    </Border>

                                                    <!-- Delete Button -->
                                                    <Button Margin="8,0,0,0"
                                                            Command="{Binding DeleteCommand}"
                                                            Style="{StaticResource DefaultButtonStyle}"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                                        <FontIcon FontSize="14"
                                                                  Foreground="{ThemeResource SystemErrorTextColor}"
                                                                  Glyph="&#xE74D;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="2"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing Width="48"
                              Height="48"
                              IsActive="True" />
                <TextBlock Margin="0,12,0,0"
                           Text="Loading models..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
