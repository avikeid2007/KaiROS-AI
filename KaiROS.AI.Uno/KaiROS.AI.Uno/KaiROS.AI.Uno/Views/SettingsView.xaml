<UserControl x:Class="KaiROS.AI.Uno.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:KaiROS.AI.Uno.Converters"
             xmlns:models="using:KaiROS.AI.Uno.Models">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32">
            <!-- Header -->
            <Border Margin="0,0,0,16"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="Settings" />
                    <TextBlock Margin="0,4,0,0"
                               Opacity="0.7"
                               Text="Configure hardware, appearance, and API settings" />
                </StackPanel>
            </Border>

            <!-- Hardware Section -->
            <Border Margin="0,0,0,16"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Hardware" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="12"
                                       Opacity="0.6"
                                       Text="GPU" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding GpuInfo}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12"
                                       Opacity="0.6"
                                       Text="Memory" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding RamInfo}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Padding="12"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="12"
                                       Opacity="0.6"
                                       Text="Execution Backend" />
                            <ComboBox Margin="0,8,0,0"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AvailableBackends}"
                                      SelectedItem="{Binding SelectedBackend, Mode=TwoWay}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Text="{Binding BackendStatus}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding UseRecommendedBackendCommand}"
                                    Content="Use Recommended" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshHardwareInfoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Margin="0,0,8,0"
                                      FontSize="14"
                                      Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh Hardware Info" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Appearance Section -->
            <Border Margin="0,0,0,16"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Appearance" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Dark Theme" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Text="Use dark color scheme" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Prompt Section -->
            <Border Margin="0,0,0,16"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="System Prompt" />

                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Opacity="0.6"
                               Text="Default instructions for the AI assistant" />

                    <TextBox MinHeight="100"
                             Margin="0,12,0,0"
                             AcceptsReturn="True"
                             Text="{Binding SystemPrompt, Mode=TwoWay}"
                             TextWrapping="Wrap" />

                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetSystemPromptCommand}"
                            Content="Reset to Default" />
                </StackPanel>
            </Border>

            <!-- API Section -->
            <Border Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Local API Server" />

                    <TextBlock Margin="0,8,0,0"
                               FontSize="12"
                               Opacity="0.6"
                               Text="Expose the model via OpenAI-compatible API" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Enable API Server" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Text="{Binding ApiStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsEnabled="{Binding CanEnableApi}"
                                      IsOn="{Binding IsApiEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="Port:" />
                        <TextBox Grid.Column="1"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Text="{Binding ApiPort, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Models Directory Section -->
            <Border Margin="0,16,0,0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Storage" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="12"
                                       Opacity="0.6"
                                       Text="Models Directory" />
                            <TextBlock Margin="0,4,0,0"
                                       IsTextSelectionEnabled="True"
                                       Text="{Binding ModelsDirectory}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
