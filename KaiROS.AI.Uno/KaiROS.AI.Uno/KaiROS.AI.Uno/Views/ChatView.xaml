<UserControl x:Class="KaiROS.AI.Uno.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:KaiROS.AI.Uno.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringFormatConverter x:Key="StringFmt" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Session Sidebar -->
        <Border Width="220"
                Margin="0,0,16,0"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="{Binding IsSessionListVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- New Chat Button -->
                <Button Margin="0,0,0,12"
                        Command="{Binding NewSessionCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  FontSize="14"
                                  Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="New Chat" />
                    </StackPanel>
                </Button>

                <!-- Session List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="Medium"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Opacity="0.6">
                                            <Run Text="{Binding MessageCount, Mode=OneWay}" />
                                            <Run Text="messages" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           Text="No chat history yet"
                           Visibility="{Binding Sessions.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            </Grid>
        </Border>

        <!-- Main Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Margin="0,0,0,16"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Text="Chat" />
                        <TextBlock Margin="0,4,0,0"
                                   Opacity="0.7"
                                   Text="{Binding ActiveModelInfo}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ClearChatCommand}"
                                Style="{StaticResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon VerticalAlignment="Center"
                                          FontSize="13"
                                          Glyph="&#xE74D;" />
                                <TextBlock VerticalAlignment="Center" Text=" Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer x:Name="MessagesScroller"
                          Grid.Row="1"
                          Margin="0,0,0,16"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!-- User Message -->
                                <Border MaxWidth="600"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <Border Padding="16,12"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="16,16,4,16">
                                        <StackPanel>
                                            <Image MaxWidth="400"
                                                   MaxHeight="300"
                                                   Margin="0,0,0,8"
                                                   Source="{Binding AttachedImagePath}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Foreground="White"
                                                       Text="{Binding Content}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       Opacity="0.5"
                                                       Text="{Binding Timestamp}" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <!-- Assistant Message -->
                                <Border MaxWidth="600"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                    <Border Padding="16,12"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            CornerRadius="16,16,16,4">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,8"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       Text="Assistant" />
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       Text="{Binding Timestamp}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       Text="..."
                                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input Area -->
            <Border Grid.Row="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Options Row -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Text="Web Search" />
                                <ToggleSwitch MinWidth="0"
                                              IsOn="{Binding IsWebSearchEnabled, Mode=TwoWay}"
                                              OffContent=""
                                              OnContent="" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Attached Image Indicator -->
                        <Border Padding="8,4"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="4"
                                Visibility="{Binding HasAttachedImage, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          FontSize="14"
                                          Glyph="&#xEB9F;" />
                                <TextBlock FontWeight="Medium" Text="Image Attached" />
                                <Button Height="16"
                                        Margin="8,0,0,0"
                                        Padding="4,0"
                                        Command="{Binding RemoveAttachedImageCommand}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Input TextBox -->
                    <TextBox x:Name="MessageInput"
                             Grid.Row="1"
                             MaxHeight="150"
                             AcceptsReturn="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Text="{Binding UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             PlaceholderText="Type your message..." />

                    <!-- Send Button -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <Button Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Send" />
                                <FontIcon Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          FontSize="14"
                                          Glyph="&#xE724;" />
                            </StackPanel>
                        </Button>

                        <Button BorderBrush="{ThemeResource SystemErrorTextColor}"
                                Command="{Binding StopGenerationCommand}"
                                Style="{StaticResource DefaultButtonStyle}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon VerticalAlignment="Center"
                                          FontSize="14"
                                          Glyph="&#xE71A;" />
                                <TextBlock VerticalAlignment="Center" Text=" Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Performance Stats -->
            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontSize="12" Glyph="&#xE945;" Opacity="0.6" />
                        <TextBlock Margin="4,0,0,0" FontSize="12" Opacity="0.6">
                            <Run Text="{Binding TokensPerSecond, Converter={StaticResource StringFmt}, ConverterParameter='{}{0:F1}'}" />
                            <Run Text="tok/s" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                        <FontIcon FontSize="12" Glyph="&#xE9F3;" Opacity="0.6" />
                        <TextBlock Margin="4,0,0,0" FontSize="12" Opacity="0.6">
                            <Run Text="{Binding TotalTokens}" />
                            <Run Text="tokens" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                        <FontIcon FontSize="12" Glyph="&#xE950;" Opacity="0.6" />
                        <TextBlock Margin="4,0,0,0" FontSize="12" Opacity="0.6" Text="{Binding MemoryUsage}" />
                    </StackPanel>
                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                        <FontIcon FontSize="12" Glyph="&#xE916;" Opacity="0.6" />
                        <TextBlock Margin="4,0,0,0" FontSize="12" Opacity="0.6" Text="{Binding ElapsedTime}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
