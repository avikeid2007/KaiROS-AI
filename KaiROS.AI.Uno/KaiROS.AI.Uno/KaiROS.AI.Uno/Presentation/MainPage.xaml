<Page x:Class="KaiROS.AI.Uno.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="using:KaiROS.AI.Uno.Converters"
      xmlns:views="using:KaiROS.AI.Uno.Views"
      xmlns:vm="using:KaiROS.AI.Uno.ViewModels"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringFormatConverter x:Key="StringFmt" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- View Templates -->
        <DataTemplate x:Key="CatalogTemplate">
            <views:ModelCatalogView />
        </DataTemplate>
        <DataTemplate x:Key="ChatTemplate">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate x:Key="DocumentTemplate">
            <views:DocumentView />
        </DataTemplate>
        <DataTemplate x:Key="SettingsTemplate">
            <views:SettingsView />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsPaneOpen="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <Border Padding="16,8,16,8">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold">
                                <Run Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Kai" />
                                <Run Text="ROS AI" />
                            </TextBlock>
                            <TextBlock FontSize="11" Opacity="0.6" Text="Local AI Assistant" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Models" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF158;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Chat" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="RAG as a Service" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF571;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <!-- Active model info card -->
                <Border Margin="12,0,12,16"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="11" Opacity="0.6" Text="Active Model" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding ActiveModelName}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ActiveModelName, Converter={StaticResource NullToVis}}" />
                        <TextBlock FontSize="12"
                                   Opacity="0.6"
                                   Text="No model loaded"
                                   Visibility="{Binding ActiveModelName, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                        <Border Height="1"
                                Margin="0,8"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock FontSize="11"
                                   Opacity="0.6"
                                   Text="{Binding HardwareInfo}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Main content area -->
            <Grid Padding="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Content -->
                <ContentControl x:Name="ContentHost"
                                Margin="24,0,24,0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{Binding CurrentView}" />

                <!-- Loading Overlay -->
                <Border Background="#80000000"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressRing Width="64"
                                      Height="64"
                                      IsActive="True" />
                        <TextBlock Margin="0,16,0,0"
                                   FontSize="16"
                                   Text="Initializing..." />
                    </StackPanel>
                </Border>

                <!-- Status Bar -->
                <Border Grid.Row="1"
                        Padding="16,8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.7"
                                   Text="{Binding StatusText}" />
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{ThemeResource SystemErrorTextColor}"
                                   Text="{Binding ErrorMessage}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />
                    </Grid>
                </Border>
            </Grid>

        </NavigationView>
    </Grid>
</Page>
