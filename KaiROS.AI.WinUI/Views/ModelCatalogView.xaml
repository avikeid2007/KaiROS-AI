<UserControl
    x:Class="KaiROS.AI.WinUI.Views.ModelCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KaiROS.AI.WinUI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:KaiROS.AI.WinUI.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:CategoryToColorConverter x:Key="CategoryToColor" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
        <converters:StringFormatConverter x:Key="StringFmt" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="Model Catalog" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="Download and manage AI models for local inference" />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding AddCustomModelCommand}"
                Content="+ Add Custom Model"
                Style="{StaticResource AccentButton}" />
        </Grid>

        <!--  Filter Bar  -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ctk:WrapPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalSpacing="16" VerticalSpacing="12">
                
                <!--  Size Toggle (Segmented style)  -->
                <Border
                    Padding="4"
                    Background="{ThemeResource SurfaceLightBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Padding="16,8"
                            BorderThickness="0"
                            Background="Transparent"
                            Command="{Binding FilterByCategoryCommand}"
                            CommandParameter="all"
                            Content="All"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Padding="16,8"
                            BorderThickness="0"
                            Background="Transparent"
                            Command="{Binding FilterByCategoryCommand}"
                            CommandParameter="small"
                            Content="Small"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Padding="16,8"
                            BorderThickness="0"
                            Background="Transparent"
                            Command="{Binding FilterByCategoryCommand}"
                            CommandParameter="medium"
                            Content="Medium"
                            Style="{StaticResource SecondaryButton}" />
                        <Button
                            Padding="16,8"
                            BorderThickness="0"
                            Background="Transparent"
                            Command="{Binding FilterByCategoryCommand}"
                            CommandParameter="large"
                            Content="Large"
                            Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>

                <!--  Filters  -->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <ComboBox
                        Width="120"
                        Header="Organization"
                        ItemsSource="{Binding Organizations}"
                        SelectedItem="{Binding SelectedOrganization, Mode=TwoWay}"
                        Style="{StaticResource ModernComboBox}" />

                    <ComboBox
                        Width="120"
                        Header="Family"
                        ItemsSource="{Binding Families}"
                        SelectedItem="{Binding SelectedFamily, Mode=TwoWay}"
                        Style="{StaticResource ModernComboBox}" />

                    <ComboBox
                        Width="120"
                        Header="Variant"
                        ItemsSource="{Binding Variants}"
                        SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                        Style="{StaticResource ModernComboBox}" />

                    <ComboBox
                        Width="120"
                        Header="Vision Support"
                        ItemsSource="{Binding VisionOptions}"
                        SelectedItem="{Binding SelectedVisionOption, Mode=TwoWay}"
                        Style="{StaticResource ModernComboBox}" />
                </StackPanel>
            </ctk:WrapPanel>

            <!--  Right Actions  -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12">
                <ToggleButton
                    x:Name="RecommendedToggle"
                    Content="&#x2605; Recommended"
                    IsChecked="{Binding ShowRecommendedOnly}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="border"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="Checked">
                                                        <VisualState.Setters>
                                                            <Setter Target="border.Background" Value="{ThemeResource AccentBrush}" />
                                                            <Setter Target="border.BorderBrush" Value="{ThemeResource AccentBrush}" />
                                                            <Setter Target="contentPresenter.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="border.Background" Value="{ThemeResource SurfaceLightBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="CheckedPointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="border.Background" Value="{ThemeResource AccentDarkBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed" />
                                                    <VisualState x:Name="Disabled" />
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <AutoSuggestBox
                    Width="200"
                    VerticalAlignment="Center"
                    PlaceholderText="Search models..."
                    QueryIcon="Find"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <!--  Model List  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  Downloaded Models Section (Always at Top)  -->
                <Border Style="{StaticResource DownloadedSectionBorder}" Visibility="{Binding DownloadedModels.Count, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentBrush}"
                                Text="&#x2713;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text=" Downloaded Models" />
                            <Border
                                Margin="12,0,0,0"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding DownloadedModels.Count}" />
                            </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DownloadedModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Style="{ThemeResource CardBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                    <Image
                                                        Width="24"
                                                        Height="24"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Source="{Binding Model.OrgLogoUrl, Converter={StaticResource UrlToImage}}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                                        Text="{Binding Model.DisplayName}" />
                                                    <Border
                                                        Margin="12,0,0,0"
                                                        Padding="8,4"
                                                        Background="{ThemeResource PrimaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="ACTIVE" />
                                                    </Border>
                                                    <Border
                                                        Margin="6,0,0,0"
                                                        Padding="6,3"
                                                        Background="{ThemeResource SurfaceLightBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                                            Text="{Binding Model.Family}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,8"
                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                    Text="{Binding Model.Description}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="13" Foreground="{ThemeResource TextMutedBrush}">
                                                        <Run Text=" " /><Run Text="{Binding Model.SizeText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <!--  Error Message  -->
                                                <TextBlock
                                                    Margin="0,8,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource ErrorBrush}"
                                                    Text="{Binding ErrorMessage}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="20,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SetActiveCommand}"
                                                    Content="Load Model"
                                                    IsEnabled="{Binding IsActive, Converter={StaticResource InverseBool}}"
                                                    Style="{StaticResource PrimaryButton}" />
                                                <Button Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE74D;"
                                                        ToolTipService.ToolTip="Delete model" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Organization Sections  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="All Models by Organization" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ExpandAllCommand}" ToolTipService.ToolTip="Expand all">
                            <FontIcon Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding CollapseAllCommand}" ToolTipService.ToolTip="Collapse all">
                            <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding GroupedModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource OrganizationExpander}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            Text="{Binding OrganizationName}" />
                                        <Border
                                            Margin="12,0,0,0"
                                            Padding="10,3"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource PrimaryBrush}"
                                            CornerRadius="10">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="White">
                                                <Run Text="{Binding ModelCount, Mode=OneWay}" />
                                                <Run Text=" models" />
                                            </TextBlock>
                                        </Border>
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SurfaceLightBrush}"
                                            CornerRadius="10"
                                            Visibility="{Binding DownloadedCount, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentBrush}">
                                                <Run Text="{Binding DownloadedCount, Mode=OneWay}" />
                                                <Run Text=" downloaded" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Models}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12" Style="{ThemeResource CardBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                                            <Image
                                                                Width="24"
                                                                Height="24"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding Model.OrgLogoUrl, Converter={StaticResource UrlToImage}}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                                Text="{Binding Model.DisplayName}" />
                                                            <Border
                                                                Margin="12,0,0,0"
                                                                Style="{StaticResource RecommendedBadge}"
                                                                Visibility="{Binding Model.IsRecommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="&#x2605; Recommended" />
                                                            </Border>
                                                            <Border Margin="8,0,0,0" Style="{StaticResource CategoryBadge}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Model.Category}">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{Binding Model.Category, Converter={StaticResource CategoryToColor}}" />
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                            </Border>
                                                            <Border
                                                                Margin="6,0,0,0"
                                                                Padding="6,3"
                                                                Background="{ThemeResource SurfaceLightBrush}"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                                    Text="{Binding Model.Family}" />
                                                            </Border>
                                                            <Border
                                                                Margin="6,0,0,0"
                                                                Padding="6,3"
                                                                Background="{ThemeResource SurfaceLightBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding Model.Variant, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                                    Text="{Binding Model.Variant}" />
                                                            </Border>
                                                            <Border
                                                                Margin="8,0,0,0"
                                                                Padding="8,4"
                                                                Background="{ThemeResource PrimaryBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="White"
                                                                    Text="ACTIVE" />
                                                            </Border>
                                                            <Border
                                                                Margin="6,0,0,0"
                                                                Padding="6,3"
                                                                Background="{ThemeResource AccentBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="White"
                                                                    Text="&#x2713; Downloaded" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock
                                                            Margin="0,0,0,12"
                                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                                            Text="{Binding Model.Description}"
                                                            TextWrapping="Wrap" />

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="13" Foreground="{ThemeResource TextMutedBrush}">
                                                                <Run Text=" " /><Run Text="{Binding Model.SizeText}" />
                                                            </TextBlock>
                                                            <TextBlock
                                                                Margin="16,0,0,0"
                                                                FontSize="13"
                                                                Foreground="{ThemeResource TextMutedBrush}">
                                                                <Run Text=" " /><Run Text="{Binding Model.MinRam}" /><Run Text=" RAM" />
                                                            </TextBlock>
                                                            <TextBlock
                                                                Margin="16,0,0,0"
                                                                FontSize="13"
                                                                Foreground="{ThemeResource TextMutedBrush}"
                                                                Text="{Binding Model.Capabilities}" />
                                                        </StackPanel>

                                                        <Grid Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                            <ProgressBar
                                                                Height="6"
                                                                Maximum="100"
                                                                Style="{StaticResource ModernProgressBar}"
                                                                Value="{Binding DownloadProgress}" />
                                                            <TextBlock
                                                                Margin="0,10,0,0"
                                                                HorizontalAlignment="Right"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                                Text="{Binding DownloadProgress, Converter={StaticResource StringFmt}, ConverterParameter='{}{0:F1}%'}" />
                                                        </Grid>

                                                        <!--  Error Message  -->
                                                        <TextBlock
                                                            Margin="0,8,0,0"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource ErrorBrush}"
                                                            Text="{Binding ErrorMessage}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="20,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Command="{Binding DownloadCommand}"
                                                            Content="Download"
                                                            Style="{StaticResource AccentButton}"
                                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                        <Button
                                                            Command="{Binding PauseCommand}"
                                                            Content="&#x23F8; Pause"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                                        <Button
                                                            Command="{Binding ResumeCommand}"
                                                            Content="&#x25B6; Resume"
                                                            Style="{StaticResource AccentButton}"
                                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowLoadButton, Converter={StaticResource BoolToVis}}">
                                                            <Button
                                                                Margin="0,0,8,0"
                                                                Command="{Binding SetActiveCommand}"
                                                                IsEnabled="{Binding IsActive, Converter={StaticResource InverseBool}}"
                                                                Style="{StaticResource PrimaryButton}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <!--  Loading Spinner (WinUI 3: ProgressRing)  -->
                                                                    <ProgressRing
                                                                        Width="12"
                                                                        Height="12"
                                                                        Margin="0,0,8,0"
                                                                        Foreground="White"
                                                                        IsActive="{Binding IsLoading}"
                                                                        IsIndeterminate="True"
                                                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                                                                    <TextBlock Text="Load Model" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}">
                                                                <FontIcon
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    FontSize="14"
                                                                    Glyph="&#xE74D;"
                                                                    ToolTipService.ToolTip="Delete model" />
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
