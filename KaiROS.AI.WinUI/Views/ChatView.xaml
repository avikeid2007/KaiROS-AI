<UserControl
    x:Class="KaiROS.AI.WinUI.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KaiROS.AI.WinUI.Converters"
    xmlns:vm="using:KaiROS.AI.WinUI.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:MarkdownContentConverter x:Key="MarkdownConverter" />
        <converters:StringFormatConverter x:Key="StringFmt" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Session Sidebar  -->
        <Border
            Width="220"
            Margin="0,0,16,0"
            Padding="12"
            Background="{ThemeResource CardBrush}"
            CornerRadius="12"
            Visibility="{Binding IsSessionListVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  New Chat Button  -->
                <Button
                    Margin="0,0,0,12"
                    Command="{Binding NewSessionCommand}"
                    Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="New Chat" />
                    </StackPanel>
                </Button>

                <!--  Session List  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{ThemeResource SurfaceLightBrush}"
                                    CornerRadius="8"
                                    Tapped="SessionItem_Tapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="Medium"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextMutedBrush}">
                                                <Run Text="{Binding MessageCount, Mode=OneWay}" />
                                                <Run Text="messages &#x2022;" />
                                                <Run Text="{Binding UpdatedAt, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Click="DeleteSession_Click"
                                            Opacity="0.6"
                                            Style="{StaticResource IconButton}"
                                            Tag="{Binding}">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="13"
                                                Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  Empty State  -->
                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextMutedBrush}"
                    Text="No chat history yet"
                    Visibility="{Binding Sessions.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
            </Grid>
        </Border>

        <!--  Main Chat Area  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header with Model Info  -->
            <Border
                Margin="0,0,0,16"
                Padding="16"
                Background="{ThemeResource CardBrush}"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="Chat" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding ActiveModelInfo}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ClearChatCommand}"
                            Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xE74D;" />
                                <TextBlock VerticalAlignment="Center" Text=" Clear" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ToggleSearchCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTipService.ToolTip="Search (Ctrl+F)">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE721;" />
                        </Button>
                        <!--  Search Bar (collapsible)  -->
                        <Border
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Background="{ThemeResource SurfaceLightBrush}"
                            CornerRadius="8"
                            Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Width="150"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ModernTextBox}"
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Margin="4,0,0,0"
                                    Padding="4,2"
                                    Command="{Binding CloseSearchCommand}"
                                    Style="{StaticResource SecondaryButton}">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button x:Name="ExportButton" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xE8A9;" />
                                <TextBlock VerticalAlignment="Center" Text=" Export" />
                                <FontIcon
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="10"
                                    Glyph="&#xE70D;"
                                    Opacity="0.7" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="ExportMenu">
                                    <MenuFlyoutItem Command="{Binding ExportChatAsMarkdownCommand}" Text="Export as Markdown (.md)" />
                                    <MenuFlyoutItem Command="{Binding ExportChatAsJsonCommand}" Text="Export as JSON (.json)" />
                                    <MenuFlyoutItem Command="{Binding ExportChatAsTextCommand}" Text="Export as Text (.txt)" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Messages  -->
            <ScrollViewer
                x:Name="MessagesScroller"
                Grid.Row="1"
                Margin="0,0,0,16"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!--  User Message  -->
                                <Border
                                    MaxWidth="600"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                    <Border
                                        Padding="16,12"
                                        Background="{ThemeResource PrimaryBrush}"
                                        CornerRadius="16,16,4,16">
                                        <StackPanel>
                                            <!--  Attached Image Display  -->
                                            <Image
                                                MaxWidth="400"
                                                MaxHeight="300"
                                                Margin="0,0,0,8"
                                                Source="{Binding AttachedImagePath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />

                                            <TextBlock
                                                Foreground="White"
                                                Text="{Binding Content}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="White"
                                                Opacity="0.5"
                                                Text="{Binding Timestamp}" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <!--  Assistant Message  -->
                                <Border
                                    MaxWidth="600"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                    <Border
                                        Padding="16,12"
                                        Background="{ThemeResource SurfaceLightBrush}"
                                        CornerRadius="16,16,16,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource PrimaryLightBrush}"
                                                    Text="&#xE9CE; Assistant" />

                                                <!--  Copy Button  -->
                                                <Button
                                                    Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="4"
                                                    Command="{Binding CopyContentCommand}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipService.ToolTip="Copy Response">
                                                    <Path
                                                        Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
                                                        Fill="{ThemeResource TextSecondaryBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                            <ContentPresenter Content="{Binding Content, Converter={StaticResource MarkdownConverter}}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextMutedBrush}"
                                                Text="{Binding Timestamp}" />

                                            <!--  Streaming Indicator  -->
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="14"
                                                Foreground="{ThemeResource PrimaryBrush}"
                                                Text="&#x2022;&#x2022;&#x2022;"
                                                Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Input Area  -->
            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBrush}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <!--  Knowledge Base Selector  -->
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="Knowledge Base" />
                                <ComboBox
                                    Width="180"
                                    Padding="6,4"
                                    VerticalContentAlignment="Center"
                                    ItemsSource="{Binding AvailableKnowledgeBases}"
                                    SelectedItem="{Binding SelectedKnowledgeBase, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="Web Search" />
                                <ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{Binding IsWebSearchEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    ToolTipService.ToolTip="Enable Web Search to fetch real-time info" />
                            </StackPanel>

                            <!--  Enter to Send Toggle  -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="Enter to Send" />
                                <ToggleSwitch
                                    MinWidth="0"
                                    IsOn="{Binding IsEnterToSendEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    ToolTipService.ToolTip="Press Enter to send message" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Attached Document Indicator  -->
                        <Border
                            Margin="0,0,8,0"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding CurrentDocumentName, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    Text="{Binding CurrentDocumentName}" />
                                <Button
                                    Height="16"
                                    Margin="8,0,0,0"
                                    Padding="4,0"
                                    Command="{Binding RemoveDocumentCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTipService.ToolTip="Remove attached document">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!--  Attached Image Indicator  -->
                        <Border
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SurfaceBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasAttachedImage, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xEB9F;" />
                                <TextBlock
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    Text="Image Attached" />
                                <Button
                                    Height="16"
                                    Margin="8,0,0,0"
                                    Padding="4,0"
                                    Command="{Binding RemoveAttachedImageCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTipService.ToolTip="Remove attached image">
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="10"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBox
                        x:Name="MessageInput"
                        Grid.Row="1"
                        MaxHeight="150"
                        AcceptsReturn="True"
                        AllowDrop="True"
                        DragOver="MessageInput_DragOver"
                        Drop="MessageInput_Drop"
                        PreviewKeyDown="MessageInput_PreviewKeyDown"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{StaticResource ModernTextBox}"
                        Text="{Binding UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Ctrl+Enter to send (or Enter if enabled)">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="Enter"
                                Invoked="SendAccelerator_Invoked"
                                Modifiers="Control" />
                            <KeyboardAccelerator
                                Key="N"
                                Invoked="NewSessionAccelerator_Invoked"
                                Modifiers="Control" />
                            <KeyboardAccelerator
                                Key="L"
                                Invoked="ClearChatAccelerator_Invoked"
                                Modifiers="Control" />
                            <KeyboardAccelerator
                                Key="F"
                                Invoked="ToggleSearchAccelerator_Invoked"
                                Modifiers="Control" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <!--  Upload Image Button  -->
                        <Button
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Command="{Binding AttachImageCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTipService.ToolTip="Attach Image (Vision Model Required)"
                            Visibility="{Binding IsVisionModelReady, Converter={StaticResource BoolToVis}}">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xE91B;" />
                        </Button>

                        <!--  Upload Document Button  -->
                        <Button
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Command="{Binding UploadDocumentCommand}"
                            Style="{StaticResource SecondaryButton}"
                            ToolTipService.ToolTip="Attach text document">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xEA90;" />
                        </Button>

                        <!--  Send Button  -->
                        <Button
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="Send" />
                                <FontIcon
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE724;" />
                            </StackPanel>
                        </Button>

                        <!--  Stop Button  -->
                        <Button
                            BorderBrush="{ThemeResource ErrorBrush}"
                            Command="{Binding StopGenerationCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="14"
                                    Glyph="&#xE71A;" />
                                <TextBlock VerticalAlignment="Center" Text=" Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Performance Stats  -->
            <Border
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12"
                Background="{ThemeResource SurfaceBrush}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE945;" />
                        <Run Text="{Binding TokensPerSecond, Converter={StaticResource StringFmt}, ConverterParameter='{}{0:F1}'}" />
                        <Run Text="tok/s" />
                    </TextBlock>
                    <TextBlock
                        Margin="20,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE9F3;" />
                        <Run Text="{Binding TotalTokens}" />
                        <Run Text="tokens" />
                    </TextBlock>
                    <TextBlock
                        Margin="20,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE950;" />
                        <Run Text="{Binding MemoryUsage}" />
                    </TextBlock>
                    <TextBlock
                        Margin="20,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE916;" />
                        <Run Text="{Binding ElapsedTime}" />
                    </TextBlock>
                    <TextBlock
                        Margin="20,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE8EF;" />
                        <Run Text="Ctx:" />
                        <Run Text="{Binding ContextWindow}" />
                    </TextBlock>
                    <TextBlock
                        Margin="20,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xECE4;" />
                        <Run Text="GPU:" />
                        <Run Text="{Binding GpuLayers}" />
                        <Run Text="layers" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

