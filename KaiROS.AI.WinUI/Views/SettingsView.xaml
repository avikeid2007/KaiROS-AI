<UserControl
    x:Class="KaiROS.AI.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KaiROS.AI.WinUI.Converters"
    xmlns:models="using:KaiROS.AI.WinUI.Models">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BackendToStringConverter x:Key="BackendToString" />
        <converters:ContextWindowOptionConverter x:Key="ContextWindowOptionConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  Header  -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="Settings" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="Configure hardware, storage, and runtime options" />
            </StackPanel>

            <!--  Appearance Settings  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE771;" />
                        <Run Text=" Appearance" />
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="Theme" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="Choose between dark and light mode" />
                        </StackPanel>

                        <!--  Theme Toggle  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <FontIcon
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xE706;" />
                            <ToggleSwitch
                                MinWidth="0"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                IsOn="{Binding IsDarkTheme, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <FontIcon
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="&#xE708;" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Context Window Settings  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE8A2;" />
                        <Run Text=" Context Window" />
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="Context Window Size" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="How many tokens the model can hold in memory. Larger = longer conversations but more RAM." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding ContextWindowOptions}"
                            SelectedItem="{Binding SelectedContextWindow, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ContextWindowOption">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <Binding Converter="{StaticResource ContextWindowOptionConverter}" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="12"
                            Foreground="{ThemeResource AccentBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AccentBrush}"
                            Text="{Binding ActiveContextInfo}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="11"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextMutedBrush}"
                        Text="Auto selects the maximum safe size based on your model and available RAM. Changes take effect immediately." />
                </StackPanel>
            </Border>

            <!--  API Settings  -->

            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE714;" />
                        <Run Text=" API Server" />
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="Enable Local API" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="Expose OpenAI-compatible REST API on localhost" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding CanEnableApi}"
                            IsOn="{Binding IsApiEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="Port" />
                        <TextBox
                            Width="100"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Style="{ThemeResource ModernTextBox}"
                            Text="{Binding ApiPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="Status" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource AccentBrush}"
                                Text="{Binding ApiStatus}" />
                            <Button
                                Margin="12,0,0,0"
                                Padding="8,4"
                                Background="{ThemeResource AccentBrush}"
                                BorderThickness="0"
                                Click="OpenApiUrl_Click"
                                CornerRadius="4"
                                FontSize="11"
                                Foreground="White"
                                Visibility="{Binding IsApiEnabled, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="11"
                                        Glyph="&#xE8A7;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="Open" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="11"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextMutedBrush}"
                        Text="Use with VS Code Continue, LM Studio clients, or curl" />
                </StackPanel>
            </Border>

            <!--  Hardware Information  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" />
                        <Run Text=" Hardware Information" />
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="GPU:" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,8"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{Binding GpuInfo}" />

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="System RAM:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{Binding RamInfo}" />
                    </Grid>

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding RefreshHardwareInfoCommand}"
                        Style="{ThemeResource SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Glyph="&#xE72C;" />
                            <TextBlock VerticalAlignment="Center" Text="Refresh Hardware Info" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Execution Backend  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE945;" />
                        <Run Text=" Execution Backend" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Choose how model inference runs. GPU acceleration provides better performance."
                        TextWrapping="Wrap" />

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="Available Backends:" />

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding AvailableBackends}"
                            SelectedItem="{Binding SelectedBackend, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="border"
                                                    Margin="0,0,12,0"
                                                    Padding="16,12"
                                                    Background="{ThemeResource SurfaceLightBrush}"
                                                    BorderBrush="{ThemeResource BorderBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="8">
                                                    <TextBlock Foreground="{ThemeResource TextPrimaryBrush}" Text="{Binding Converter={StaticResource BackendToString}}" />
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="SelectionStates">
                                                            <VisualState x:Name="Unselected" />
                                                            <VisualState x:Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Target="border.BorderBrush" Value="{ThemeResource PrimaryBrush}" />
                                                                    <Setter Target="border.Background" Value="{ThemeResource PrimaryBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="border.BorderBrush" Value="{ThemeResource PrimaryLightBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!--  Backend Options as Buttons  -->
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Content="CPU"
                                Style="{ThemeResource SecondaryButton}"
                                Tag="Cpu" />
                            <Button
                                Margin="0,0,8,0"
                                Content="CUDA (NVIDIA)"
                                IsEnabled="{Binding Hardware.HasCuda}"
                                Style="{ThemeResource SecondaryButton}"
                                Tag="Cuda" />
                            <Button
                                Margin="0,0,8,0"
                                Content="DirectML"
                                IsEnabled="{Binding Hardware.HasDirectML}"
                                Style="{ThemeResource SecondaryButton}"
                                Tag="DirectML" />
                            <Button
                                Content="NPU"
                                IsEnabled="{Binding Hardware.HasNpu}"
                                Style="{ThemeResource SecondaryButton}"
                                Tag="Npu" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{ThemeResource SurfaceBrush}"
                        CornerRadius="8">
                        <TextBlock
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding BackendStatus}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding UseRecommendedBackendCommand}"
                        Style="{ThemeResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                Glyph="&#xE735;" />
                            <TextBlock VerticalAlignment="Center" Text="Use Recommended" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Storage Settings  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xED25;" />
                        <Run Text=" Model Storage" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Choose where downloaded models are stored. Models can be several GBs in size."
                        TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            IsReadOnly="True"
                            Style="{ThemeResource ModernTextBox}"
                            Text="{Binding ModelsDirectory}" />

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Command="{Binding BrowseModelsDirectoryCommand}"
                            Style="{ThemeResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xED25;" />
                                <TextBlock VerticalAlignment="Center" Text="Browse" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  System Prompt  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE8BD;" />
                        <Run Text=" System Prompt" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Configure the default personality and behavior of the AI assistant."
                        TextWrapping="Wrap" />

                    <TextBox
                        MinHeight="100"
                        MaxHeight="200"
                        AcceptsReturn="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Style="{ThemeResource ModernTextBox}"
                        Text="{Binding SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Command="{Binding ResetSystemPromptCommand}"
                            Style="{ThemeResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="13"
                                    Glyph="&#xE72C;" />
                                <TextBlock VerticalAlignment="Center" Text="Reset to Default" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Agent Mode & Tools Settings  -->
            <Border Margin="0,0,0,16" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE9D5;" />
                        <Run Text=" Agent Tools Configuration" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,0,0,16"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="Configure which tools are available for the AI assistant when in Agent Mode."
                        TextWrapping="Wrap" />

                    <!-- Grid of Tool Toggles -->
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- FileReaderTool -->
                        <StackPanel Grid.Row="0">
                            <TextBlock FontWeight="SemiBold" Text="File Reader" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows reading text files within allowed folders" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1" MinWidth="0" IsOn="{Binding IsFileReaderEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- FileWriterTool -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="File Writer" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows creating or modifying files (requires approval)" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsFileWriterEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- WebFetchTool -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Web Fetch" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows fetching text content from external URLs" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsWebFetchEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- CalculatorTool -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Calculator" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows executing simple math expressions safely" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsCalculatorEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- SystemInfoTool -->
                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="System Info" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows retrieving OS version, memory, CPU, and running processes" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsSystemInfoEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- DateTimeTool -->
                        <StackPanel Grid.Row="5" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Date &amp; Time" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows getting the current date, time, and time zones" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsDateTimeEnabled, Mode=TwoWay}" OffContent="" OnContent="" />

                        <!-- ClipboardTool -->
                        <StackPanel Grid.Row="6" Margin="0,8,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Clipboard" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" Text="Allows reading from or writing to the system clipboard (requires approval for write)" />
                        </StackPanel>
                        <ToggleSwitch Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" MinWidth="0" IsOn="{Binding IsClipboardEnabled, Mode=TwoWay}" OffContent="" OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  About Section  -->
            <Border Margin="0,16,0,0" Style="{ThemeResource CardBorder}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}">
                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE946;" />
                        <Run Text=" About KaiROS AI" />
                    </TextBlock>

                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap">
                        <Run Text="KaiROS AI" />
                        <Run Text="is a local AI assistant powered by" />
                        <Run FontWeight="SemiBold" Text="LLamaSharp" />
                        <Run Text=". Run large language models privately on your own hardware without sending data to the cloud." />
                    </TextBlock>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextMutedBrush}">
                        <Run Text="Version 1.0.4 � Built with .NET 9 � " />
                    </TextBlock>

                    <StackPanel Margin="0,20,0,0" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Padding="16,10"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentBrush}"
                                BorderThickness="0"
                                Click="FeedbackHub_Click"
                                CornerRadius="6"
                                Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Glyph="&#xE8BD;" />
                                    <TextBlock VerticalAlignment="Center" Text="Send Feedback" />
                                </StackPanel>
                            </Button>

                            <Button
                                Padding="16,10"
                                HorizontalAlignment="Left"
                                Click="RateApp_Click"
                                CornerRadius="6"
                                Style="{ThemeResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Glyph="&#xE339;" />
                                    <TextBlock VerticalAlignment="Center" Text="Rate in Microsoft Store" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Padding="16,10"
                                HorizontalAlignment="Left"
                                Click="GitHubIssues_Click"
                                CornerRadius="6"
                                Style="{ThemeResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Glyph="&#xEBE8;" />
                                    <TextBlock VerticalAlignment="Center" Text="Feature Request &amp; Bug Report" />
                                </StackPanel>
                            </Button>

                            <Button
                                Padding="16,10"
                                HorizontalAlignment="Left"
                                Click="GitHubRepo_Click"
                                CornerRadius="6"
                                Style="{ThemeResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="13"
                                        Glyph="&#xE734;" />
                                    <TextBlock VerticalAlignment="Center" Text="Star on GitHub" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

