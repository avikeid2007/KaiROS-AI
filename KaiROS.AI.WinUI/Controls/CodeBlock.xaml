<UserControl x:Class="KaiROS.AI.WinUI.Controls.CodeBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="{StaticResource SurfaceLightBrush}" 
            CornerRadius="8" 
            Padding="0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header with language and copy button -->
            <Border Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="8,8,0,0" 
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="LanguageLabel"
                               Text="code"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>
                    
                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Click="CopyButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CopyBtnBorder"
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="CopyBtnBorder.Background" Value="#313244"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed"/>
                                                        <VisualState x:Name="Disabled"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CopyText" Text="Copy" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Code content -->
            <ScrollViewer Grid.Row="1" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="400">
                <TextBlock x:Name="CodeContent"
                           FontFamily="Consolas, 'Courier New', monospace"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Padding="16,12"
                           TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
